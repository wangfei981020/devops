https://www.zyixinn.com/archives/centos%E5%8D%87%E7%BA%A7%E5%86%85%E6%A0%B8%E7%9A%84%E4%B8%89%E7%A7%8D%E6%96%B9%E5%BC%8F



helm install istio-base ./base --namespace istio-system --create-namespace
helm install istiod ./istiod --namespace istio-system

helm install istio-ingressgateway ./gateway --namespace istio-system


helm repo add harbor https://helm.goharbor.io
helm repo update

helm show values harbor/harbor > values.yaml

helm install harbor harbor/harbor -f values.yaml -n harbor


# 修改 istio 为Nodeport 类型
kubectl patch svc istio-ingressgateway -n istio-system -p '{"spec": {"type": "NodePort"}}'

# 默认开启 istio 注入
kubectl label namespace <your-namespace> istio-injection=enabled

# 打标签
kubectl label node k8s-master node-role.kubernetes.io/worker=worker

