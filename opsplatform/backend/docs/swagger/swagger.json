{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "供内部开发对接的 API Key 接口。所有请求需带 X-API-Key 头。\n基础 URL: http://\u003chost\u003e/api",
        "title": "运维平台 · 内部对接 API",
        "termsOfService": "内部使用",
        "contact": {
            "name": "运维平台"
        },
        "license": {
            "name": "Internal"
        },
        "version": "1.0"
    },
    "host": "localhost:30081",
    "basePath": "/api",
    "paths": {
        "/api-docs/domains": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "api_docs"
                ],
                "summary": "获取当前用户可见的 API 文档业务域",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handlers.DomainResponseItem"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api-docs/spec": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "api_docs"
                ],
                "summary": "按业务域返回过滤后的 OpenAPI spec",
                "parameters": [
                    {
                        "type": "string",
                        "description": "业务域 code，如 table_maintenance",
                        "name": "domain",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "spec 文件不存在（构建时未生成）",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/custom-tables/{id}": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "返回表元信息、列定义、所有行数据。响应里每行带 source_api_key_id 字段（标识是哪个 API Key 创建的）。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "table_maintenance"
                ],
                "summary": "获取桌台维护记录列表",
                "parameters": [
                    {
                        "type": "string",
                        "description": "table_id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.GetCustomTableResponse"
                        }
                    },
                    "403": {
                        "description": "API Key 缺少 read 权限",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/custom-tables/{id}/rows": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "通过 API Key 创建一条新的维护记录。截图字段需先调 /storage/upload 拿到 path 再放入 data 中。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "table_maintenance"
                ],
                "summary": "创建桌台维护记录",
                "parameters": [
                    {
                        "type": "string",
                        "description": "table_id (固定值：09ccbe4d-fcce-44f2-b689-725894111e80)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "记录内容",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.CreateRowRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.CreateRowResponse"
                        }
                    },
                    "400": {
                        "description": "请求参数无效",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "API Key 缺少 create 权限",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/custom-tables/{id}/rows/{rowId}": {
            "put": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "PUT 会整体替换 data 字段：未传的子字段会被覆盖为空。如果需要保留原值，请用 PATCH。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "table_maintenance"
                ],
                "summary": "全量更新记录（PUT）",
                "parameters": [
                    {
                        "type": "string",
                        "description": "table_id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "记录ID",
                        "name": "rowId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "完整记录内容",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.UpdateRowRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "请求参数无效",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "API Key 缺少 update 权限或行属于其他 API Key",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "table_maintenance"
                ],
                "summary": "删除记录",
                "parameters": [
                    {
                        "type": "string",
                        "description": "table_id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "记录ID",
                        "name": "rowId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.SuccessResponse"
                        }
                    },
                    "403": {
                        "description": "API Key 缺少 delete 权限或行属于其他 API Key",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "PATCH 会浅合并 data 字段：未传的子字段保留原值，传了的子字段覆盖。**推荐二次编辑用这个**。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "table_maintenance"
                ],
                "summary": "部分更新记录（PATCH）",
                "parameters": [
                    {
                        "type": "string",
                        "description": "table_id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "记录ID",
                        "name": "rowId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "需要更新的字段（只传要改的）",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.PatchRowRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/hierarchy": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "返回平台配置的合法 projects/sites/tables/gameTypes，用于客户端字段校验。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "table_maintenance"
                ],
                "summary": "获取桌台层级配置",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.HierarchyResponse"
                        }
                    }
                }
            }
        },
        "/storage/presign": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "传 path query 参数，返回可临时直接访问该文件的 URL。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "table_maintenance"
                ],
                "summary": "获取预签名 URL（单个）",
                "parameters": [
                    {
                        "type": "string",
                        "description": "文件 path（来自上传响应）",
                        "name": "path",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.PresignedURLResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/storage/presign/batch": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "一次请求获取多个文件的预签名 URL，减少网络往返。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "table_maintenance"
                ],
                "summary": "获取预签名 URL（批量）",
                "parameters": [
                    {
                        "description": "文件 path 列表",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.BatchPresignRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.BatchPresignResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/storage/upload": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "multipart/form-data 上传文件，返回 path。把 path 放入记录的截图字段（如 notify_start_screenshot）。",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "table_maintenance"
                ],
                "summary": "上传文件",
                "parameters": [
                    {
                        "type": "file",
                        "description": "要上传的文件（图片）",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.UploadResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "API Key 缺少 upload 权限",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.BatchPresignRequest": {
            "type": "object",
            "properties": {
                "paths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "uploads/a.png",
                        "uploads/b.png"
                    ]
                }
            }
        },
        "handlers.BatchPresignResponse": {
            "type": "object",
            "properties": {
                "urls": {
                    "type": "object"
                }
            }
        },
        "handlers.CreateRowRequest": {
            "type": "object",
            "properties": {
                "attachments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handlers.FileAttachment"
                    }
                },
                "data": {
                    "$ref": "#/definitions/handlers.MaintenanceRecordData"
                }
            }
        },
        "handlers.CreateRowResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "269bb917-fcce-44f2-b689-725894111e80"
                },
                "message": {
                    "type": "string",
                    "example": "数据添加成功"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "handlers.DomainResponseItem": {
            "type": "object",
            "properties": {
                "can_try_it": {
                    "type": "boolean"
                },
                "code": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "sort_order": {
                    "type": "integer"
                }
            }
        },
        "handlers.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "请求参数无效"
                }
            }
        },
        "handlers.FileAttachment": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "example": "通知开始截图.png"
                },
                "path": {
                    "type": "string",
                    "example": "uploads/xxx.png"
                }
            }
        },
        "handlers.GetCustomTableResponse": {
            "type": "object",
            "properties": {
                "column_config": {
                    "type": "object"
                },
                "columns": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                },
                "rows": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                },
                "table": {
                    "type": "object"
                }
            }
        },
        "handlers.HierarchyResponse": {
            "type": "object",
            "properties": {
                "gameTypes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "百家乐",
                        "龙虎",
                        "轮盘"
                    ]
                },
                "projects": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "利升"
                    ]
                },
                "sites": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "PT",
                        "欧洲厅",
                        "卡卡湾"
                    ]
                },
                "tables": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "P001",
                        "P002",
                        "E001"
                    ]
                }
            }
        },
        "handlers.MaintenanceRecordData": {
            "type": "object",
            "properties": {
                "affect_settlement": {
                    "type": "string",
                    "enum": [
                        "是",
                        "否"
                    ],
                    "example": "否"
                },
                "affected_projects": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "利升",
                        "未接入"
                    ]
                },
                "affected_round_ids": {
                    "type": "string"
                },
                "affected_sites": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "affected_tables": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "P001",
                        "P002"
                    ]
                },
                "close_duration": {
                    "type": "string",
                    "enum": [
                        "两分钟内",
                        "五分钟内",
                        "十分钟内",
                        "十分钟以上"
                    ],
                    "example": "五分钟内"
                },
                "date": {
                    "type": "string",
                    "example": "2026-05-28"
                },
                "end_time": {
                    "type": "string",
                    "example": "2026-05-28 18:15"
                },
                "game_types": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "inspector": {
                    "type": "string",
                    "example": "李四"
                },
                "maintenance_type": {
                    "type": "string",
                    "enum": [
                        "紧急维护",
                        "临时维护",
                        "例行维护",
                        "无"
                    ],
                    "example": "紧急维护"
                },
                "notify_end_screenshot": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handlers.FileAttachment"
                    }
                },
                "notify_start_screenshot": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handlers.FileAttachment"
                    }
                },
                "operation": {
                    "type": "string",
                    "enum": [
                        "维护",
                        "取消",
                        "重算",
                        "重派彩",
                        "包桌T人",
                        "漏操作",
                        "漏截图"
                    ],
                    "example": "维护"
                },
                "operator": {
                    "type": "string",
                    "example": "张三"
                },
                "qc_status": {
                    "type": "string",
                    "enum": [
                        "正常",
                        "异常"
                    ],
                    "example": "正常"
                },
                "reason": {
                    "type": "string",
                    "example": "系统更新维护"
                },
                "remark": {
                    "type": "string",
                    "example": "已完成，运行正常"
                },
                "start_duration": {
                    "type": "string",
                    "enum": [
                        "两分钟内",
                        "五分钟内",
                        "十分钟内",
                        "十分钟以上"
                    ],
                    "example": "两分钟内"
                },
                "start_time": {
                    "type": "string",
                    "example": "2026-05-28 18:00"
                },
                "table_status": {
                    "type": "string"
                }
            }
        },
        "handlers.PatchRowRequest": {
            "type": "object",
            "properties": {
                "attachments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handlers.FileAttachment"
                    }
                },
                "data": {
                    "type": "object"
                }
            }
        },
        "handlers.PresignedURLResponse": {
            "type": "object",
            "properties": {
                "expires_in": {
                    "type": "integer",
                    "example": 3600
                },
                "url": {
                    "type": "string",
                    "example": "https://minio.../uploads/xxx.png?X-Amz-Signature=..."
                }
            }
        },
        "handlers.SuccessResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "操作成功"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "handlers.UpdateRowRequest": {
            "type": "object",
            "properties": {
                "attachments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handlers.FileAttachment"
                    }
                },
                "data": {
                    "$ref": "#/definitions/handlers.MaintenanceRecordData"
                }
            }
        },
        "handlers.UploadResponse": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string",
                    "example": "uploads/2026/05/xxx.png"
                },
                "url": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "type": "apiKey",
            "name": "X-API-Key",
            "in": "header"
        }
    }
}