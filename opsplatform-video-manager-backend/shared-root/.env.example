# PostgreSQL Database Configuration
POSTGRES_USER=videomanager
POSTGRES_PASSWORD=videomanager
POSTGRES_DB=videomanager
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Database Connection String (for backend)
DATABASE_URL=postgres://videomanager:videomanager@localhost:5432/videomanager?sslmode=disable

# Backend API Configuration
API_PORT=8080

# OIDC SSO (optional; can also be configured in admin System Settings)
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must match your OIDC provider callback setting, e.g. http://localhost:8080/api/auth/oidc/callback
OIDC_REDIRECT_URL=
# Space-separated scopes; default is "openid profile email"
OIDC_SCOPES=
# Frontend callback target, default /login
OIDC_FRONTEND_SUCCESS_URL=http://localhost:3000/login
API_HOST=localhost

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
